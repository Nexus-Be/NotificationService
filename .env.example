# =============================================================================
# ENVIRONMENT VARIABLES FOR NOTIFICATION SERVICE (.env.example)
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
NOTIFICATION_SERVICE_PORT=8007
NOTIFICATION_DB_PORT=5439

# Database Connection (Neon Cloud PostgreSQL)
CONNECTION_STRING=Host=ep-green-hill-b5e070g5-pooler.c-7.us-east-2.aws.neon.tech;Port=5432;Database=notification_db;Username=neondb_owner;Password=<REPLACE_WITH_NOTIFICATION_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true
NOTIFICATION_CONNECTION_STRING=Host=ep-green-hill-b5e070g5-pooler.c-7.us-east-2.aws.neon.tech;Port=5432;Database=notification_db;Username=neondb_owner;Password=<REPLACE_WITH_NOTIFICATION_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true

# Database (PostgreSQL Port: 5439 Local Fallback)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<REPLACE_WITH_DB_PASSWORD>

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=<REPLACE_WITH_RABBITMQ_PASSWORD>

# SMTP Gmail Configuration (Use Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_SENDER_NAME=Nexus Ecosystem
SMTP_SENDER_EMAIL=<YOUR_GMAIL_ADDRESS>
SMTP_USERNAME=<YOUR_GMAIL_ADDRESS>
SMTP_PASSWORD=<YOUR_GOOGLE_APP_PASSWORD>

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
