# =============================================================================
# ENVIRONMENT VARIABLES FOR NOTIFICATION SERVICE (.env.example)
# =============================================================================
# Hỗ trợ 2 hồ sơ môi trường:
#   1. Local DB (PostgreSQL Cục bộ port 5439): cp .env.local.example .env
#   2. Server DB (PostgreSQL Neon Cloud):      cp .env.server.example .env
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
NOTIFICATION_SERVICE_PORT=8007

# Database Connection (Mặc định Local DB)
CONNECTION_STRING=Host=localhost;Port=5439;Database=notification_db;Username=postgres;Password=postgres
NOTIFICATION_CONNECTION_STRING=Host=localhost;Port=5439;Database=notification_db;Username=postgres;Password=postgres
NOTIFICATION_DB_PORT=5439
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_SENDER_NAME=Nexus Ecosystem
SMTP_SENDER_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
