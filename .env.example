# =============================================================================
# ENVIRONMENT VARIABLES FOR NOTIFICATION SERVICE (.env.example)
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
NOTIFICATION_SERVICE_PORT=8007

# Database Connection (Local PostgreSQL - Port 5439)
CONNECTION_STRING=Host=localhost;Port=5439;Database=notification_db;Username=postgres;Password=postgres
NOTIFICATION_CONNECTION_STRING=Host=localhost;Port=5439;Database=notification_db;Username=postgres;Password=postgres
NOTIFICATION_DB_PORT=5439
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# RabbitMQ (Docker network: rabbitmq; Local host: localhost)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# =============================================================================
# SMTP EMAIL CONFIGURATION (DỊCH VỤ GỬI EMAIL - GMAIL / RESEND / MAILTRAP)
# =============================================================================
# 1. Nếu dùng Google Gmail SMTP (Miễn phí, gửi thật đến inbox):
#    - SMTP_HOST=smtp.gmail.com
#    - SMTP_PORT=587
#    - SMTP_USE_SSL=false
#    - SMTP_USERNAME=<tai_khoan_gmail_cua_ban@gmail.com>
#    - SMTP_PASSWORD=<mat_khau_ung_dung_16_ky_tu_google_app_password>
#    - SMTP_SENDER_EMAIL=<tai_khoan_gmail_cua_ban@gmail.com>
#    - SMTP_SENDER_NAME=Nexus Ecosystem
#
# 2. Nếu dùng Mailtrap (Dành cho dev kiểm thử an toàn, không gửi vào mail thật):
#    - SMTP_HOST=sandbox.smtp.mailtrap.io
#    - SMTP_PORT=2525
#    - SMTP_USERNAME=<mailtrap_username>
#    - SMTP_PASSWORD=<mailtrap_password>
# SMTP Gmail Configuration (Use Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_SENDER_NAME=Nexus Ecosystem
SMTP_SENDER_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
