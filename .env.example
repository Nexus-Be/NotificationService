# Environment variables for Notification Service
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8007

# Database (PostgreSQL Port: 5439)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5439;Database=notification_db;Username=postgres;Password=MatkhaucuaTui123@

# RabbitMQ
RabbitMq__Host=localhost
RabbitMq__Port=5672
RabbitMq__User=guest
RabbitMq__Password=MatkhaucuaTui123@

# SMTP Gmail Configuration (Use Google App Password)
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__UseSsl=false
Smtp__SenderName=Nexus Ecosystem
Smtp__SenderEmail=
Smtp__Username=
Smtp__Password=

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
