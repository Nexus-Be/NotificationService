# =============================================================================
# NEXUS NOTIFICATION SERVICE - ENVIRONMENT (.env.example)
# =============================================================================
# DB dùng Neon Cloud PostgreSQL. Hạ tầng dùng chung nexus-network.

ASPNETCORE_ENVIRONMENT=Development
NOTIFICATION_SERVICE_PORT=8007

# Database (Neon Cloud PostgreSQL)
NOTIFICATION_DB_CONNECTION=postgresql://<USERNAME>:<PASSWORD>@<HOST>/notification?sslmode=require&channel_binding=require

# JWT signing
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=shoppingcart-api
JWT_SIGNATURE=eaT0Ombups70WJzd85CBBpp8rAno55SxKn1qvYBGH9e
JWT_EXPIRATION_IN_MINUTES=60

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_SENDER_NAME=Nexus Ecosystem
SMTP_SENDER_EMAIL=tayduy0502@gmail.com
SMTP_USERNAME=tayduy0502@gmail.com
SMTP_PASSWORD=fduoxzipmiravgrz

# Internal service-to-service authentication
INTERNAL_SERVICE_SECRET=eaT0Ombups70WJzd85CBBpp8rAno55SxKn1qvYBGH9e

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317

# Durable database email worker (MaxAttempts is total submissions)
NOTIFICATION_DELIVERY_WORKER_ENABLED=true
NOTIFICATION_RETRY_LIMIT=3
NOTIFICATION_DELIVERY_BASE_DELAY_SECONDS=10
NOTIFICATION_DELIVERY_POLL_SECONDS=5
NOTIFICATION_DELIVERY_TIMEOUT_SECONDS=30
NOTIFICATION_DELIVERY_LEASE_SECONDS=120

# FCM: credentials must be mounted separately outside the repository
FCM_PROJECT_ID=
FCM_CREDENTIALS_CONTAINER_PATH=

# Event log retention is opt-in; physical purge after 90 days from server CreatedAt
NOTIFICATION_EVENT_LOG_RETENTION_ENABLED=false
NOTIFICATION_EVENT_LOG_RETENTION_BATCH_SIZE=500
NOTIFICATION_EVENT_LOG_RETENTION_MAX_BATCHES=20
NOTIFICATION_EVENT_LOG_RETENTION_INTERVAL_SECONDS=3600
NOTIFICATION_EVENT_LOG_RETENTION_TIMEOUT_SECONDS=120

# Readiness checks (Compose maps these to Health section)
NOTIFICATION_HEALTH_DB_TIMEOUT_SECONDS=3
NOTIFICATION_HEALTH_WORKER_GRACE_SECONDS=30
NOTIFICATION_HEALTH_OTP_STALL_SECONDS=120

# Durable OTP worker; Compose mounts persistent Data Protection key volume
NOTIFICATION_OTP_POLL_SECONDS=1
NOTIFICATION_OTP_TIMEOUT_SECONDS=30
NOTIFICATION_OTP_LEASE_SECONDS=120
NOTIFICATION_OTP_MAX_ATTEMPTS=3
NOTIFICATION_OTP_BASE_DELAY_SECONDS=5
