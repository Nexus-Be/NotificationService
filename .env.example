# =============================================================================
# ENVIRONMENT VARIABLES FOR NOTIFICATION SERVICE (.env.example)
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
NOTIFICATION_SERVICE_PORT=8007
NOTIFICATION_DB_PORT=5439

# Database Connection (Docker network: notification-db:5432; Local host: localhost:5439)
CONNECTION_STRING=Host=notification-db;Port=5432;Database=notification_db;Username=postgres;Password=<REPLACE_WITH_NOTIFICATION_DB_PASSWORD>
NOTIFICATION_CONNECTION_STRING=Host=notification-db;Port=5432;Database=notification_db;Username=postgres;Password=<REPLACE_WITH_NOTIFICATION_DB_PASSWORD>

# Database (PostgreSQL Port: 5439 Local Fallback)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<REPLACE_WITH_DB_PASSWORD>

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=<REPLACE_WITH_RABBITMQ_PASSWORD>

# SMTP Gmail Configuration (Use Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_SENDER_NAME=Nexus Ecosystem
SMTP_SENDER_EMAIL=<YOUR_GMAIL_ADDRESS>
SMTP_USERNAME=<YOUR_GMAIL_ADDRESS>
SMTP_PASSWORD=<YOUR_GOOGLE_APP_PASSWORD>

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
