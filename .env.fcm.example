# Set these in your private environment or existing untracked .env.
# Public project ID must match the FE Firebase project, registration token and VAPID key.
FCM_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
# Absolute host path to a service-account JSON outside this repository.
FCM_CREDENTIALS_HOST_PATH=C:/private/firebase-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS is set by docker-compose.fcm.yml inside the container.
