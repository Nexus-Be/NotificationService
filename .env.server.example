# =============================================================================
# NEXUS NOTIFICATION SERVICE - SERVER ENVIRONMENT CONFIGURATION (.env.server.example)
# =============================================================================
# Áp dụng: cp .env.server.example .env

ASPNETCORE_ENVIRONMENT=Development
NOTIFICATION_SERVICE_PORT=8007

# Database (Neon Cloud PostgreSQL)
NOTIFICATION_DB_CONNECTION=Host=REPLACE_WITH_HOST;Port=5432;Database=notification_db;Username=REPLACE_WITH_USERNAME;Password=REPLACE_WITH_PASSWORD;SSL Mode=Require

# JWT signing
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=shoppingcart-api
JWT_SIGNATURE=REPLACE_WITH_JWT_SIGNATURE
JWT_EXPIRATION_IN_MINUTES=60

# Downstream services
USER_SERVICE_URL=http://localhost:8001

# Email provider ("Smtp" or "Brevo")
EMAIL_PROVIDER=Brevo

# Brevo Transactional Email API (HTTPS - recommended for Render)
BREVO_BASE_URL=https://api.brevo.com/v3/
BREVO_API_KEY=REPLACE_WITH_BREVO_API_KEY
BREVO_SENDER_NAME=Nexus
BREVO_SENDER_EMAIL=REPLACE_WITH_VERIFIED_BREVO_SENDER_EMAIL
BREVO_TIMEOUT_SECONDS=30

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_SENDER_NAME=Nexus Ecosystem
SMTP_SENDER_EMAIL=REPLACE_WITH_SMTP_EMAIL
SMTP_USERNAME=REPLACE_WITH_SMTP_EMAIL
SMTP_PASSWORD=REPLACE_WITH_SMTP_APP_PASSWORD

# Internal service-to-service authentication
INTERNAL_SERVICE_SECRET=REPLACE_WITH_INTERNAL_SERVICE_SECRET
AUCTION_NOTIFICATION_SERVICE_USER_ID=00000000-0000-0000-0000-0000000000a1
AUCTION_NOTIFICATION_SIGNING_KEY=REPLACE_WITH_AUCTION_NOTIFICATION_SIGNING_KEY
WALLET_NOTIFICATION_SERVICE_KEY=REPLACE_WITH_WALLET_NOTIFICATION_SERVICE_KEY

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Workers & health
NOTIFICATION_DELIVERY_WORKER_ENABLED=true
NOTIFICATION_APPLY_MIGRATIONS=false
NOTIFICATION_HEALTH_DB_TIMEOUT_SECONDS=15

# Set true and supply OTP_SHARED_KEY_RING_BASE64 when sharing a DB across multiple replicas.
OTP_REQUIRE_SHARED_KEY_RING=true
OTP_SHARED_KEY_RING_BASE64=REPLACE_WITH_SHARED_KEY_RING_BASE64
