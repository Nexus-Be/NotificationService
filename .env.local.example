# =============================================================================
# NEXUS NOTIFICATION SERVICE - ENVIRONMENT (.env.local.example)
# =============================================================================
# DB local (cụm src/Infrastructure/databases). Hạ tầng dùng chung nexus-network.

ASPNETCORE_ENVIRONMENT=Development
NOTIFICATION_SERVICE_PORT=8007

# Database (Neon Cloud PostgreSQL)
NOTIFICATION_DB_CONNECTION=Host=localhost;Port=5439;Database=notification_db;Username=postgres;Password=REPLACE_WITH_LOCAL_PASSWORD

# JWT signing
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=shoppingcart-api
JWT_SIGNATURE=REPLACE_WITH_JWT_SIGNATURE
JWT_EXPIRATION_IN_MINUTES=60

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_SENDER_NAME=Nexus Ecosystem
SMTP_SENDER_EMAIL=REPLACE_WITH_SMTP_EMAIL
SMTP_USERNAME=REPLACE_WITH_SMTP_EMAIL
SMTP_PASSWORD=REPLACE_WITH_SMTP_APP_PASSWORD

# Internal service-to-service authentication
INTERNAL_SERVICE_SECRET=REPLACE_WITH_INTERNAL_SERVICE_SECRET

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Receive the actual values privately from the owner; never generate per-machine OTP keys.
OTP_REQUIRE_SHARED_KEY_RING=true
OTP_SHARED_KEY_RING_BASE64=REPLACE_WITH_SHARED_KEY_RING_BASE64
NOTIFICATION_APPLY_MIGRATIONS=false
