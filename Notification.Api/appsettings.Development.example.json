{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "InternalSecurity": {
    "ServiceKey": "REPLACE_WITH_INTERNAL_SERVICE_SECRET"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=REPLACE_WITH_HOST;Port=5432;Database=notification_db;Username=REPLACE_WITH_USERNAME;Password=REPLACE_WITH_PASSWORD;SSL Mode=Require"
  },
  "Jwt": {
    "Issuer": "http://localhost:8001",
    "Audience": "shoppingcart-api",
    "Signature": "REPLACE_WITH_JWT_SIGNATURE",
    "ExpirationInMinutes": 60
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UseSsl": false,
    "SenderName": "Nexus Ecosystem",
    "SenderEmail": "REPLACE_WITH_SMTP_EMAIL",
    "Username": "REPLACE_WITH_SMTP_EMAIL",
    "Password": "REPLACE_WITH_SMTP_APP_PASSWORD"
  },
  "Otel": {
    "Endpoint": "http://localhost:4317"
  },
  "DeliveryWorker": {
    "Enabled": true,
    "MaxAttempts": 3,
    "BaseDelaySeconds": 10,
    "PollIntervalSeconds": 5,
    "AttemptTimeoutSeconds": 30,
    "LeaseSeconds": 120
  },
  "Fcm": {
    "ProjectId": ""
  },
  "EventLogRetention": {
    "Enabled": false,
    "BatchSize": 500,
    "MaxBatchesPerRun": 20,
    "IntervalSeconds": 3600,
    "RunTimeoutSeconds": 120
  },
  "Health": {
    "DatabaseTimeoutSeconds": 15,
    "WorkerGraceSeconds": 30,
    "OtpStallSeconds": 120
  },
  "OtpWorker": {
    "PollIntervalSeconds": 1,
    "SendTimeoutSeconds": 30,
    "LeaseSeconds": 120,
    "MaxAttempts": 3,
    "BaseDelaySeconds": 5
  },
  "OtpProtection": {
    "KeyRingPath": "",
    "RequireSharedKeyRing": true,
    "SharedKeyRingBase64": "REPLACE_WITH_SHARED_KEY_RING_BASE64"
  },
  "DatabaseInitialization": {
    "ApplyMigrationsOnStartup": false
  }
}
